// Resource script for the shipped exe. Compiled by stamp_resources.py.
//
// The SDK headers are not installed on every build machine, so the few
// constants VERSIONINFO needs are written out instead of including windows.h.

#define IDI_APP 1

IDI_APP ICON "AppIcon.ico"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x00040000L
FILETYPE 0x00000001L
FILESUBTYPE 0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KizakiWorks"
            VALUE "FileDescription", "HP Professor 1 DPI"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "HP-Professor-1-DPI"
            VALUE "OriginalFilename", "HP-Professor-1-DPI-windows.exe"
            VALUE "ProductName", "HP Professor 1 DPI"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
